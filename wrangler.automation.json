import { cp, mkdir, readFile, readdir, rm, stat, writeFile } from "node:fs/promises";
import { existsSync } from "node:fs";
import path from "node:path";

const root = process.cwd();
const candidates = [
  path.join(root, "outputs", "wasla-egypt"),
  path.join(root, "wasla-egypt"),
  path.join(root, "public"),
];
const source = candidates.find((candidate) => existsSync(candidate));

if (!source) {
  throw new Error("Could not find the Khalasa web application files.");
}

const destination = path.join(root, ".cloudflare-dist");
await rm(destination, { recursive: true, force: true });
await mkdir(destination, { recursive: true });
await cp(source, destination, { recursive: true });

async function injectRuntimeConfig(directory) {
  for (const entry of await readdir(directory, { withFileTypes: true })) {
    const target = path.join(directory, entry.name);
    if (entry.isDirectory()) {
      await injectRuntimeConfig(target);
      continue;
    }
    if (!entry.isFile() || !entry.name.endsWith(".html")) continue;

    let html = await readFile(target, "utf8");
    if (html.includes("runtime-config.js")) continue;

    const script = '<script src="/runtime-config.js"></script>';
    html = /<head[^>]*>/i.test(html)
      ? html.replace(/<head([^>]*)>/i, `<head$1>${script}`)
      : script + html;
    await writeFile(target, html, "utf8");
  }
}

await injectRuntimeConfig(destination);

const routes = {
  customer: "customer.html",
  "merchant-dashboard": "merchant-dashboard.html",
  "rider-app": "rider-app.html",
  "admin-dashboard": "admin-dashboard.html",
  applications: "index.html",
};

for (const [route, sourceFile] of Object.entries(routes)) {
  const input = path.join(destination, sourceFile);
  if (!existsSync(input) || !(await stat(input)).isFile()) {
    throw new Error(`Missing route source: ${sourceFile}`);
  }
  const routeDirectory = path.join(destination, route);
  await mkdir(routeDirectory, { recursive: true });
  await cp(input, path.join(routeDirectory, "index.html"));
}

await writeFile(
  path.join(destination, "404.html"),
  '<!doctype html><html lang="ar" dir="rtl"><meta charset="utf-8"><title>خالصة</title><body><h1>الرابط غير موجود</h1><p><a href="/">العودة إلى منصة خالصة</a></p></body></html>',
  "utf8",
);

console.log(`Cloudflare bundle prepared from ${path.relative(root, source)}`);
