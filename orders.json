(function(){const api=window.KHALASA_API_BASE_URL||location.origin;async function verify(){const token=localStorage.getItem('khalasaStaffToken');if(!token)return false;return (await fetch(`${api}/v1/admin/me`,{headers:{Authorization:`Bearer ${token}`}})).ok}window.staffLogin=async e=>{e.preventDefault();staffError.textContent='جارٍ التحقق…';const r=await fetch(`${api}/v1/staff/login`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone:staffPhone.value.trim(),accessCode:staffCode.value})});if(!r.ok){staffError.textContent='بيانات الدخول غير صحيحة أو غير مصرح بها.';return}const data=await r.json();if(data.user.role!=='admin'){staffError.textContent='هذا المستخدم لا يملك صلاحية اللوحة الرئيسية.';return}localStorage.setItem('khalasaStaffToken',data.token);unlock()};function unlock(){document.body.classList.remove('staff-locked');staffGate.classList.add('hidden')}verify().then(ok=>{if(ok)unlock()}).catch(()=>{});})();
