.staff-locked .admin-shell{visibility:hidden}.staff-gate{position:fixed;inset:0;z-index:9999;background:linear-gradient(135deg,#073f34,#0b6c57);display:grid;place-items:center;padding:20px}.staff-gate.hidden{display:none}.staff-gate form{width:min(420px,100%);background:#fff;border-radius:20px;padding:30px;display:grid;gap:13px;text-align:center;box-shadow:0 25px 70px #001c1766}.staff-gate i{display:grid;place-items:center;margin:auto;width:55px;height:55px;border-radius:16px;background:#ff7145;color:#fff;font-size:28px;font-weight:800}.staff-gate h1{margin:4px 0}.staff-gate p{margin:0;color:#66746f}.staff-gate input{font:inherit;padding:12px;border:1px solid #ccd8d4;border-radius:10px}.staff-gate button{font:inherit;border:0;border-radius:10px;padding:12px;background:#08735c;color:#fff;font-weight:800}.staff-gate small{color:#b42318}
