NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://khalasa:khalasa_dev_password@localhost:5432/khalasa
JWT_SECRET=replace_with_a_long_random_secret_before_production
CORS_ORIGINS=https://your-site.netlify.app,http://localhost:4173
PLATFORM_COMMISSION_RATE=0.12
# Configure a real OTP delivery webhook before production. Development returns devOtp only.
OTP_PROVIDER=disabled
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=
STORAGE_PROVIDER=private-object-storage
